rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth.token.email.lower() in ['victortomashaugaard@gmail.com', 'ohaug01@gmail.com'];
    }
    // Samma åtkomstlista som Firestore (kräver att Storage får läsa Firestore, se README)
    function hasAccess() {
      return request.auth != null && request.auth.token.email_verified == true
        && (isAdmin() || firestore.exists(/databases/(default)/documents/access/$(request.auth.token.email.lower())));
    }
    // Profilbilder: bara inloggade läser, bara konton med åtkomst skriver, max 2 MB och endast bilder
    match /avatars/{file} {
      allow read: if request.auth != null;
      allow write: if hasAccess()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
