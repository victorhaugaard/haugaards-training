rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profilbilder: bara inloggade läser, bara ni två skriver, max 2 MB och endast bilder
    match /avatars/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email in ['victortomashaugaard@gmail.com', 'ohaug01@gmail.com']
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
