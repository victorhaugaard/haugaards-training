# Coach Smirnov (används av api/coach.ts, sätts också i Vercel)
ANTHROPIC_API_KEY=
# Kommaseparerade e-postadresser som får använda coachen
COACH_ALLOWED_EMAILS=
# Valfritt: modell (standard claude-haiku-4-5)
# COACH_MODEL=claude-haiku-4-5

# Strava-synk (används av api/strava-*.ts). Se README → "Koppla Strava".
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Valfri sträng ni hittar på själva, används bara för att verifiera webhooken
STRAVA_VERIFY_TOKEN=

# Firebase Admin (behövs bara för Strava-synken, som skriver till Firestore utan en inloggad
# användare). Firebase Console → Project settings → Service accounts → Generate new private key.
# Klistra in hela JSON-filens innehåll på en rad (eller base64-koda den).
FIREBASE_SERVICE_ACCOUNT=
